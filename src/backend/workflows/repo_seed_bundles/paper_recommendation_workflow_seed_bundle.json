          },
          {
            "target_context_key": "event",
            "source_expression": "inputs.event",
            "extractor": "identity",
            "required": false,
            "description": "Exact represented mutation event and idempotency provenance."
          },
          {
            "target_context_key": "subject_concept_id",
            "source_expression": "inputs.subject_concept_id",
            "extractor": "identity",
            "required": false,
            "description": "Optional exact profile subject projected by a represented event or caller."
          },
          {
            "target_context_key": "source_artifact_concept_id",
            "source_expression": "inputs.source_artifact_concept_id",
            "extractor": "identity",
            "required": false,
