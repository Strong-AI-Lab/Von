              "profile_scope_mode",
              "paper_matching_profile",
              "prior_scoped_assertion_id",
              "profile_evidence",
              "profile_maintenance_reason"
            ],
            "conditional_transitions": [
              {
                "to_state": "serialise_profile",
                "reason": "profile_update_proposed",
                "condition_spec": {
                  "kind": "context_value_equals",
                  "key": "profile_maintenance_decision",
                  "value": "update_profile"
                }
              },
              {
                "to_state": "render_no_change",
                "reason": "evidence_does_not_change_profile",
                "condition_spec": {
                  "kind": "context_value_equals",
                  "key": "profile_maintenance_decision",
                  "value": "no_change"
                }
              },
              {
                "to_state": "render_insufficient_evidence",
                "reason": "insufficient_or_conflicting_evidence",
                "condition_spec": {
                  "kind": "always"
                }
              }
