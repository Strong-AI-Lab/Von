              },
              "context_fields": [
                {
                  "context_key": "prompt",
                  "label": "Explicit user request"
                },
                {
                  "context_key": "conversation_situation",
                  "label": "Provisional shared situation, not publication authority"
                },
                {
                  "context_key": "subject_concept_id",
                  "label": "Candidate exact profile subject"
                },
                {
                  "context_key": "source_artifact_concept_id",
                  "label": "Represented summary or publication source"
                },
                {
                  "context_key": "source_text",
                  "label": "Untrusted source summary text"
                },
                {
                  "context_key": "source_predicate",
                  "label": "Represented source predicate"
                },
                {
                  "context_key": "source_fingerprint",
                  "label": "Stable source fingerprint"
                },
                {
                  "context_key": "evidence_kind",
                  "label": "Evidence kind"
                },
                {
                  "context_key": "event",
