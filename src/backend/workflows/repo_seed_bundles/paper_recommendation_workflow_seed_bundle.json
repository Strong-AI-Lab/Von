    {
      "workflow_id": "#V#paper_matching_profile_maintenance_workflow",
      "display_name": "Paper Matching Profile Maintenance Workflow",
      "description": "Create or revise one actor-effective paper-matching profile from a represented research summary, new publication evidence, or an explicit conversational request, with provenance and canonical read-back.",
      "content": "Resolve the exact subject and intended publication scope, read the actor-effective existing profile, use semantic judgement to merge bounded evidence while preserving explicit preferences, persist through the appropriate canonical or scoped assertion surface, replace any prior scoped revision safely, and read the result back. Downstream recommendation evaluation is event-driven and is not allowed to invalidate a successful profile write.",
      "type_ids": [
        "#V#ai_workflow",
        "#V#durable_workflow"
      ],
      "launch_input_contract": {
