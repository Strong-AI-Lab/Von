                "tool_param": "concept_id",
                "required": true
              }
            ],
            "static_input_bindings": [
              {
                "key": "predicates",
                "value": [
                  "hasName",
                  "hasDescription",
                  "hasContent",
                  "hasNote"
                ]
              },
              {
                "key": "max_relation_ids_per_group",
