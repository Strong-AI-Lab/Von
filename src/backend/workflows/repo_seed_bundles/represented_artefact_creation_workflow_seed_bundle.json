                "tool_output_field": "validated_json.existing_concept_id",
                "context_key": "represented_artefact_concept_id"
              },
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_plan_concepts_to_create_concepts",
                "tool_output_field": "validated_json.concepts",
                "context_key": "represented_artefact_create_concepts"
              },
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_plan_description_to_description_text",
                "tool_output_field": "validated_json.description_text",
                "context_key": "represented_artefact_description_text"
              },
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_plan_parent_rationale_to_parent_rationale",
                "tool_output_field": "validated_json.parent_rationale",
                "context_key": "represented_artefact_parent_rationale"
              },
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_plan_blocking_reason_to_blocking_reason",
                "tool_output_field": "validated_json.blocking_reason",
                "context_key": "represented_artefact_blocking_reason"
              }
            ],
            "writes_context_keys": [
              "represented_artefact_decision",
              "represented_artefact_name",
              "represented_artefact_code",
              "represented_artefact_kind",
              "represented_artefact_parent_id",
              "represented_artefact_concept_id",
              "represented_artefact_create_concepts",
              "represented_artefact_description_text",
              "represented_artefact_parent_rationale",
              "represented_artefact_blocking_reason"
            ],
            "conditional_transitions": [
              {
                "to_state": "read_back_concept",
                "reason": "reuse_existing_verified",
                "condition_spec": {
                  "kind": "all",
                  "conditions": [
                    {
                      "kind": "context_value_equals",
                      "key": "represented_artefact_decision",
                      "value": "reuse_existing"
                    },
                    {
                      "kind": "context_exists",
                      "key": "represented_artefact_concept_id",
                      "expected": true
                    },
                    {
                      "kind": "context_is_null",
                      "key": "represented_artefact_concept_id",
                      "expected": false
                    }
                  ]
                }
              },
              {
                "to_state": "create_represented_artefact",
                "reason": "grounded_parent_ready",
                "condition_spec": {
                  "kind": "all",
                  "conditions": [
                    {
                      "kind": "context_value_equals",
                      "key": "represented_artefact_decision",
                      "value": "create"
                    },
                    {
                      "kind": "context_exists",
                      "key": "represented_artefact_parent_id",
                      "expected": true
                    },
                    {
                      "kind": "context_is_null",
                      "key": "represented_artefact_parent_id",
                      "expected": false
                    },
                    {
                      "kind": "context_cardinality",
                      "key": "represented_artefact_create_concepts",
                      "operator": ">",
                      "value": 0
                    }
                  ]
                }
              },
              {
                "to_state": "summarise_blocker",
                "reason": "parent_resolution_failed_closed",
                "condition_spec": {
                  "kind": "always"
                }
              }
            ]
          },
          {
            "state_id": "create_represented_artefact",
            "action_id": "create_concepts",
            "execution_mode": "deterministic",
            "context_input_mapping_specs": [
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_create_parent_to_parent_id_parameter",
