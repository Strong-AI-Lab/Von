  "workflows": [
    {
      "workflow_id": "#V#represented_artefact_creation_workflow",
      "display_name": "Represented Artefact Creation Workflow",
      "description": "Generic workflow for creating or reusing small durable Vontology artefacts after resolving a grounded parent/type, then attaching supplied meaning/code text and reading the represented state back.",
      "content": "Plan a generic represented artefact from the user request, search for existing matching concepts, resolve a specific parent/type, fail closed when placement is ambiguous, create only with a grounded parent_id, attach supplied code/meaning/provenance text, and verify by fetch_concept plus get_text_relations_summary.",
      "type_ids": [
        "#V#ai_workflow",
        "#V#durable_workflow"
      ],
      "launch_input_contract": {
        "schema_version": "workflow_launch_input_contract.v1",
        "required_inputs": [
          "prompt"
        ],
        "input_mappings": [
          {
            "target_context_key": "prompt",
            "source_expression": "inputs.prompt",
            "extractor": "identity",
            "required": true,
            "description": "Pass through the represented-artefact request."
          },
          {
            "target_context_key": "user_prompt",
            "source_expression": "inputs.prompt",
            "extractor": "identity",
            "required": false,
            "description": "Alias for prompts and replay tooling that use user_prompt."
          }
        ]
      },
      "text_relations": [
        {
          "predicate": "#V#hasWorkflowRoutingProfileJson",
          "text": "{\"authoring_intent_required\": false, \"prefer_existing_capability\": false, \"role\": \"execution\", \"schema_version\": \"workflow_routing_profile.v1\"}",
          "lang": "en-NZ"
        },
        {
          "predicate": "#V#hasWorkflowDiscoveryExemplarsJson",
          "text": "{\"examples\": [\"Represent this workflow marker in the Vontology so Von can reuse it later.\", \"Create a durable label for this workflow state and read it back.\", \"Remember this marker so future email checks skip already processed suggestions.\", \"Record that this paper was suggested by Alice.\", \"Create a represented research-lab artefact for this reusable coordination object.\"], \"keywords\": [\"represented artefact creation\", \"represent label in Vontology\", \"remember workflow marker\", \"create reusable marker\", \"durable coordination artefact\", \"paper suggested by\", \"paper suggestion provenance\", \"research lab artefact\", \"Vontology marker\", \"Vontology label\"], \"schema_version\": \"workflow_discovery_exemplars.v1\"}",
          "lang": "en-NZ"
        },
        {
          "predicate": "#V#hasWorkflowLifecycleJson",
          "text": "{\"phase\": \"published\", \"published\": true, \"schema_version\": \"workflow_publication_lifecycle.v1\"}",
          "lang": "en-NZ"
        },
        {
          "predicate": "#V#hasWorkflowTerminalSuccessContractJson",
          "text": "{\"require_completed_true\": true, \"require_completion_gate_safe_to_claim_completion\": false, \"require_final_state\": true, \"require_terminal_status\": true, \"required_summary_fields\": [\"workflow_id\", \"terminal_status\", \"final_state\", \"completed\"], \"schema_version\": \"workflow_terminal_success_contract.v1\", \"success_statuses\": [\"completed\"]}",
          "lang": "en-NZ"
        },
        {
          "predicate": "#V#hasWorkflowRequiredEffectsContractJson",
          "text": "{\"contract_id\": \"represented_artefact_creation_readback\", \"required_effects\": [{\"description\": \"The workflow must read back the represented artefact concept and its text relations before claiming success.\", \"effect_id\": \"represented_artefact_readback\", \"effect_type\": \"grounded_evidence\", \"failed_failure_code\": \"represented_artefact_readback_failed\", \"missing_failure_code\": \"represented_artefact_readback_missing\", \"not_executed_reason\": \"Represented artefact read-back did not run.\", \"not_satisfied_reason\": \"Represented artefact read-back did not verify durable state.\", \"required_tools\": [\"fetch_concept\", \"get_text_relations_summary\"], \"required_tools_match\": \"all\"}], \"schema_version\": \"workflow_required_effects_contract.v1\"}",
          "lang": "en-NZ"
        }
      ],
      "publication_spec": {
        "initial_state": "plan_represented_artefact",
        "steps": [
          {
            "state_id": "plan_represented_artefact",
            "action_id": "llm.action",
            "execution_mode": "llm",
            "prompt_concept_ids": [
              "#V#prompt_represented_artefact_creation_plan"
            ],
            "llm_policy": {
              "allowed_tools": [
                "search_concepts",
                "fetch_concept"
              ],
              "context_fields": [
                {
                  "context_key": "prompt",
                  "label": "Current represented-artefact request"
                },
                {
                  "context_key": "user_prompt",
                  "label": "User prompt alias"
                },
                {
                  "context_key": "user_concept_id",
                  "label": "Authenticated user concept"
                },
                {
                  "context_key": "org_concept_id",
                  "label": "Authenticated organisation concept"
                },
                {
                  "context_key": "turn_expected_outcome_contract_state",
                  "label": "Expected outcome contract"
                },
                {
                  "context_key": "turn_expected_grounding_requirement",
                  "label": "Expected grounding requirement"
                },
                {
                  "context_key": "workflow_success_guidance_history",
                  "label": "Historical successful-run guidance"
                },
                {
                  "context_key": "workflow_failure_avoidance_history",
                  "label": "Historical failure-avoidance guidance"
                },
                {
                  "context_key": "workflow_low_imposition_exploration_history",
                  "label": "Historical minimal-imposition exploration guidance"
                }
              ],
              "max_tool_invocations": 5,
              "policy_stage": "represented_artefact_creation_plan",
              "required_tools": [
                "search_concepts"
              ],
              "response_contract_text": "Return JSON only. Resolve or fail closed before creation. A create decision must include a concrete parent_id and a one-item concepts array suitable for create_concepts. Never use #V#thing as parent. Prefer existing exact concept reuse when search verifies one. Use support types #V#workflow_marker, #V#workflow_label, #V#paper_suggestion_provenance_fact, #V#research_lab_artefact, #V#represented_artefact, or #V#predicate when grounded.",
              "tool_argument_defaults": {
                "fetch_concept": {
                  "include_relations_any_arg": true,
                  "include_text_relations_arg1": true,
                  "limit": 50
                },
                "search_concepts": {
                  "include_description": true,
                  "include_hierarchy_path": true,
                  "limit": 10,
                  "match_type": "substring"
                }
              },
              "tool_mode": "allowed"
            },
            "validation_policy": {
              "output_format": "json_value"
            },
            "tool_output_mapping_specs": [
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_plan_decision_to_decision",
                "tool_output_field": "validated_json.decision",
                "context_key": "represented_artefact_decision"
              },
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_plan_target_name_to_name",
                "tool_output_field": "validated_json.target_name",
                "context_key": "represented_artefact_name"
              },
              {
                "concept_id": "#V#workflow_mapping_represented_artefact_creation_plan_target_code_to_code",
                "tool_output_field": "validated_json.target_code",
                "context_key": "represented_artefact_code"
              },
