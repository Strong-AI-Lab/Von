                "reason": "represented_artefact_id_resolved",
                "condition_spec": {
                  "kind": "all",
                  "conditions": [
                    {
                      "kind": "context_exists",
                      "key": "represented_artefact_concept_id",
                      "expected": true
                    },
                    {
                      "kind": "context_is_null",
                      "key": "represented_artefact_concept_id",
