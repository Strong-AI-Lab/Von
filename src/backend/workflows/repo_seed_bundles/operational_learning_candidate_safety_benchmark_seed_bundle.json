          "org_id"
        ],
        "schema_version": "operational_learning_candidate_runtime_binding_contract.v1"
      },
      "schema_version": "operational_certification_policy.v1",
      "strict_represented_evaluator_results": true,
      "trial_count": 5
    }
  }
