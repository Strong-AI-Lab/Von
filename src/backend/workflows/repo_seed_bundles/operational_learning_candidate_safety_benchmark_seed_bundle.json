            "path": "/operational_metrics/namespace_violation_count"
          }
        }
      ],
      "pass_windows": [
        1,
        3,
        5
      ],
      "runtime_binding_contract": {
        "authority_note": "The campaign runtime substitutes these values unchanged before execution. The represented candidate resolver, behavioural workflow, prompts, test bundle and evaluator own semantic judgement; support code may validate only shape, exact equality and evidence hashes.",
        "candidate_metadata_binding": {
          "affected_artifact": "{{affected_artifact}}",
          "candidate_id": "{{candidate_id}}",
          "namespace": "{{namespace}}",
          "org_id": "{{org_id}}",
