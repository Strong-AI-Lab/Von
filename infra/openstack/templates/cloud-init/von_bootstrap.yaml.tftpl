#cloud-config
package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - git
  - nginx
  - openssl
  - sudo
  - ${python_package}
  - ${python_venv_package}

groups:
  - ${service_group}

users:
  - default
  - name: ${service_user}
    gecos: Von Service User
    system: true
    shell: /usr/sbin/nologin
    lock_passwd: true
    primary_group: ${service_group}
    homedir: ${app_dir}

write_files:
  - path: ${env_file}
    owner: root:root
    permissions: "0640"
    content: |
      VON_SKIP_BROWSER_LAUNCH=1
      VON_WAITRESS_THREADS=${bootstrap_waitress_threads}
      VON_EXPERT_TABS_ENABLED=1
      VON_EXPERT_FOOTER_ENABLED=1
      VON_DURABLE_WORKFLOWS_ENABLE=1
      VON_DURABLE_WORKFLOWS_BLOCKING_STARTUP=0
      FLASK_SESSION_COOKIE_HTTPONLY=1
      FLASK_SESSION_COOKIE_SAMESITE=Lax
      FLASK_SESSION_COOKIE_SECURE=${enable_https ? 1 : 0}
      GOOGLE_OAUTH_STRICT_STARTUP=${google_oauth_strict_startup ? 1 : 0}
      GOOGLE_OAUTH_ENABLE_DYNAMIC_REDIRECTS=${google_oauth_enable_dynamic_redirects ? "true" : "false"}
      OPENAI_API_KEY_FILE=${openai_api_key_file}
      GEMINI_API_KEY_FILE=${gemini_api_key_file}
%{ if default_llm_provider != null && lower(default_llm_provider) == "openai" && default_llm_model != null ~}
      VON_DEFAULT_OPENAI_MODEL=${jsonencode(default_llm_model)}
%{ endif ~}
%{ if default_llm_provider != null && lower(default_llm_provider) == "gemini" && default_llm_model != null ~}
      VON_DEFAULT_GEMINI_MODEL=${jsonencode(default_llm_model)}
%{ endif ~}
      VON_MONGO_STRICT_STARTUP=${mongo_strict_startup ? 1 : 0}
      VON_MONGO_STARTUP_PROBE=${mongo_startup_probe ? 1 : 0}
      VON_MONGO_REQUIRE_TLS=${mongo_require_tls ? 1 : 0}
      MONGO_ALLOW_LOCAL_FALLBACK=${mongo_allow_local_fallback ? 1 : 0}
      VON_MONGO_ALLOWED_HOST_SUFFIXES=${join(",", mongo_allowed_host_suffixes)}
      VON_MONGO_READ_PROBE_COLLECTION=${mongo_read_probe_collection}
      VON_MONGO_STARTUP_PROBE_COLLECTION=${mongo_write_probe_collection}
      MONGO_URI_FILE=${mongo_uri_file}
%{ if flask_secret_key != null ~}
      FLASK_SECRET_KEY=${jsonencode(flask_secret_key)}
%{ endif ~}
%{ if google_oauth_redirect_uri != null ~}
      GOOGLE_OAUTH_REDIRECT_URI=${jsonencode(google_oauth_redirect_uri)}
%{ endif ~}
      GOOGLE_OAUTH_CLIENT_ID_FILE=${google_oauth_client_id_file}
      GOOGLE_OAUTH_CLIENT_SECRET_FILE=${google_oauth_client_secret_file}

%{ if google_oauth_client_id != null ~}
  - path: ${google_oauth_client_id_file}
    owner: root:root
    permissions: "0600"
    content: |
      ${google_oauth_client_id}
%{ endif ~}

%{ if google_oauth_client_secret != null ~}
  - path: ${google_oauth_client_secret_file}
    owner: root:root
    permissions: "0600"
    content: |
      ${google_oauth_client_secret}
%{ endif ~}

%{ if openai_api_key != null ~}
  - path: ${openai_api_key_file}
    owner: root:root
    permissions: "0600"
    content: |
      ${openai_api_key}
%{ endif ~}

%{ if gemini_api_key != null ~}
  - path: ${gemini_api_key_file}
    owner: root:root
    permissions: "0600"
    content: |
      ${gemini_api_key}
%{ endif ~}

%{ if mongo_uri != null ~}
  - path: ${mongo_uri_file}
    owner: root:root
    permissions: "0600"
    content: |
      ${mongo_uri}
%{ endif ~}

  - path: /etc/systemd/system/von.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, service_unit_content)}

  - path: /etc/nginx/sites-available/von.conf
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, nginx_config_content)}

  - path: /usr/local/bin/deploy_von_release.sh
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, deploy_script_content)}

  - path: /usr/local/bin/von_ops_common.sh
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, ops_common_script_content)}

  - path: /usr/local/bin/von_monitor_health.sh
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, monitor_script_content)}

  - path: /usr/local/bin/von_collect_logs.sh
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, log_collector_script_content)}

  - path: /usr/local/bin/von_backup_snapshot.sh
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, backup_script_content)}

  - path: /usr/local/bin/von_restore_drill.sh
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, restore_drill_script_content)}

  - path: /etc/systemd/system/von-monitor.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, monitor_service_content)}

  - path: /etc/systemd/system/von-monitor.timer
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, monitor_timer_content)}

  - path: /etc/systemd/system/von-log-collector.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, log_collector_service_content)}

  - path: /etc/systemd/system/von-log-collector.timer
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, log_collector_timer_content)}

  - path: /etc/systemd/system/von-backup.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_service_content)}

  - path: /etc/systemd/system/von-backup.timer
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_timer_content)}

  - path: /etc/systemd/system/von-restore-drill.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, restore_drill_service_content)}

  - path: /etc/systemd/system/von-restore-drill.timer
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, restore_drill_timer_content)}

runcmd:
  - [bash, -lc, "set -euo pipefail; install -d -m 0755 -o ${service_user} -g ${service_group} '${app_dir}' '${release_root}' '${current_symlink_parent}' '/var/log/von'"]
  - [bash, -lc, "set -euo pipefail; install -d -m 0755 -o root -g root '${backup_directory}' '${central_log_directory}'"]
  - [bash, -lc, "set -euo pipefail; install -d -m 0755 -o root -g root /etc/von"]
  - [bash, -lc, "set -euo pipefail; install -d -m 0750 -o root -g ${service_group} /etc/von/secrets"]
  - [bash, -lc, "set -euo pipefail; for secret_file in '${google_oauth_client_id_file}' '${google_oauth_client_secret_file}' '${openai_api_key_file}' '${gemini_api_key_file}' '${mongo_uri_file}'; do if [ -f \"$secret_file\" ]; then chown root:${service_group} \"$secret_file\"; chmod 0640 \"$secret_file\"; fi; done"]
%{ if enable_https && generate_self_signed_cert ~}
  - [bash, -lc, "set -euo pipefail; if [ ! -f '${tls_cert_path}' ] || [ ! -f '${tls_key_path}' ]; then install -d -m 0755 /etc/ssl/certs /etc/ssl/private; openssl req -x509 -nodes -newkey rsa:4096 -days 365 -subj '/CN=${domain_name}' -keyout '${tls_key_path}' -out '${tls_cert_path}'; chmod 0600 '${tls_key_path}'; fi"]
%{ endif ~}
  - [bash, -lc, "set -euo pipefail; ln -sfn /etc/nginx/sites-available/von.conf /etc/nginx/sites-enabled/von.conf; rm -f /etc/nginx/sites-enabled/default; nginx -t"]
  - [bash, -lc, "set -euo pipefail; systemctl daemon-reload; systemctl enable von.service; systemctl enable nginx.service; systemctl restart nginx.service"]
%{ if enable_monitoring ~}
  - [bash, -lc, "set -euo pipefail; systemctl enable von-monitor.timer; systemctl start von-monitor.timer"]
%{ endif ~}
%{ if enable_log_collection ~}
  - [bash, -lc, "set -euo pipefail; systemctl enable von-log-collector.timer; systemctl start von-log-collector.timer"]
%{ endif ~}
%{ if enable_backup_automation ~}
  - [bash, -lc, "set -euo pipefail; systemctl enable von-backup.timer; systemctl start von-backup.timer"]
%{ endif ~}
%{ if enable_restore_drill ~}
  - [bash, -lc, "set -euo pipefail; systemctl enable von-restore-drill.timer; systemctl start von-restore-drill.timer"]
%{ endif ~}
  - [bash, -lc, "set -euo pipefail; /usr/local/bin/deploy_von_release.sh --repo-url '${bootstrap_repo_url}' --repo-ref '${bootstrap_repo_ref}' --bootstrap"]
%{ if default_llm_provider != null && default_llm_model != null && (default_llm_organisation_concept_id != null || default_llm_user_concept_id != null) ~}
  - [bash, -lc, "set -euo pipefail; set -a; . '${env_file}'; set +a; cd '${current_symlink}'; '${current_symlink}/.venv/bin/python' '${current_symlink}/scripts/bootstrap_llm_setting.py' --provider '${default_llm_provider}' --model '${default_llm_model}'%{ if default_llm_organisation_concept_id != null } --organisation-concept-id '${default_llm_organisation_concept_id}'%{ endif }%{ if default_llm_user_concept_id != null } --user-concept-id '${default_llm_user_concept_id}'%{ endif }"]
%{ endif ~}

final_message: "Von managed bootstrap completed."
