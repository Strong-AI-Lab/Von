# Copy this file to staging.tfvars and update values for your project.
# Keep real *.tfvars files untracked (gitignored).

environment = "staging"
name_prefix = "vonlab"
region_name = "REPLACE_WITH_REGION"

network_id            = "REPLACE_WITH_NETWORK_UUID"
subnet_id             = "REPLACE_WITH_SUBNET_UUID"
external_network_pool = "REPLACE_WITH_EXTERNAL_NETWORK_POOL_OR_NAME"

image_id      = "REPLACE_WITH_IMAGE_UUID"
flavor_name   = "c1.c4r8"
key_pair_name = "REPLACE_WITH_KEYPAIR_NAME"

ssh_ingress_cidrs = [
  "203.0.113.20/32"
]

application_ingress_rules = [
  {
    protocol         = "tcp"
    port_range_min   = 80
    port_range_max   = 80
    remote_ip_prefix = "203.0.113.20/32"
    description      = "HTTP redirect to HTTPS (restricted source example)"
  },
  {
    protocol         = "tcp"
    port_range_min   = 443
    port_range_max   = 443
    remote_ip_prefix = "203.0.113.20/32"
    description      = "Von HTTPS reverse proxy"
  }
]

allowed_egress_cidrs = [
  "0.0.0.0/0"
]

create_persistent_volume = true
persistent_volume_size_gb = 160
persistent_volume_type    = null
volume_device             = "/dev/vdb"

assign_floating_ip        = true
create_floating_ip        = true
existing_floating_ip_address = null

metadata = {
  owner       = "replace-with-owner"
  cost_centre = "research-staging"
}

enable_managed_bootstrap = true
bootstrap_repo_url       = "https://github.com/Strong-AI-Lab/Von.git"
bootstrap_repo_ref       = "main"
bootstrap_domain_name    = "staging-von.example.org"
bootstrap_enable_https   = true

# For a first bootstrap on a new host, this creates a temporary self-signed cert.
# Replace with managed cert paths for trusted production/staging TLS.
bootstrap_generate_self_signed_cert = true

bootstrap_enable_monitoring        = true
bootstrap_enable_log_collection    = true
bootstrap_enable_backup_automation = true
bootstrap_enable_restore_drill     = true
bootstrap_alert_webhook_url        = null

# OAuth hardening (set real values via secure runtime injection, not committed tfvars):
# - Preferred: place secrets on host at bootstrap_google_oauth_client_id_file /
#   bootstrap_google_oauth_client_secret_file.
# - Optional: inject via TF_VAR_bootstrap_google_oauth_client_id,
#   TF_VAR_bootstrap_google_oauth_client_secret, and TF_VAR_bootstrap_flask_secret_key.
bootstrap_google_oauth_strict_startup          = false
bootstrap_google_oauth_redirect_uri            = null
bootstrap_google_oauth_enable_dynamic_redirects = false
# Do not assign secret variables to null in *.tfvars: tfvars values override
# TF_VAR_* runtime injection. Leave these unset unless intentionally supplying
# a non-committed value in your local ignored tfvars file.
# bootstrap_flask_secret_key = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"
# bootstrap_google_oauth_client_id = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"
# bootstrap_google_oauth_client_secret = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"

# LLM provider bootstrap for real chat/workflow execution.
# Leave bootstrap_openai_api_key unset when using TF_VAR_bootstrap_openai_api_key.
# Setting it to null here prevents runtime injection from reaching cloud-init.
# bootstrap_openai_api_key = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"
bootstrap_openai_api_key_file = "/etc/von/secrets/openai_api_key"
# Leave bootstrap_gemini_api_key unset when using TF_VAR_bootstrap_gemini_api_key.
# bootstrap_gemini_api_key = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"
bootstrap_gemini_api_key_file = "/etc/von/secrets/gemini_api_key"
# Leave bootstrap_meta_api_key unset when using TF_VAR_bootstrap_meta_api_key.
# Meta Muse remains opt-in; do not make it the default without an explicit scoped model.
# bootstrap_meta_api_key = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"
bootstrap_meta_api_key_file = "/etc/von/secrets/meta_api_key"
# Leave bootstrap_openrouter_api_key unset when using TF_VAR_bootstrap_openrouter_api_key.
# OpenRouter remains opt-in; do not make it the default without an explicit scoped model.
# bootstrap_openrouter_api_key = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"
bootstrap_openrouter_api_key_file = "/etc/von/secrets/openrouter_api_key"

# Optional: seed a scoped model setting after first deploy.
# Set all three values together to seed the organisation default.
# bootstrap_default_llm_provider = "openai"
# bootstrap_default_llm_model = "gpt-5.5"
# Gemini alternative: provider = "gemini", model = "gemini-3.7-flash".
# Meta Muse alternative: provider = "meta", model = "muse-spark-1.3".
# bootstrap_default_llm_organisation_concept_id = "#V#university_of_auckland_strong_ai_lab"

# Mongo Atlas hardening for hosted staging.
bootstrap_mongo_strict_startup         = true
bootstrap_mongo_startup_probe          = true
bootstrap_mongo_require_tls            = true
bootstrap_mongo_allow_local_fallback   = false
bootstrap_mongo_allowed_host_suffixes  = [".mongodb.net"]
# Leave bootstrap_mongo_uri unset when using TF_VAR_bootstrap_mongo_uri.
# Setting it to null here prevents runtime injection from reaching cloud-init.
# bootstrap_mongo_uri = "REPLACE_WITH_LOCAL_UNTRACKED_SECRET"
bootstrap_mongo_uri_file               = "/etc/von/secrets/mongo_uri"
bootstrap_mongo_read_probe_collection  = "application_settings"
bootstrap_mongo_write_probe_collection = "_von_startup_probe"
