{
	"inputs": [],
	"servers": {
		"vontology": {
			"type": "stdio",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"src/backend/mcp_server/mcp_stdio_server.py"
			],
			"cwd": "${workspaceFolder}"
		},
		"vonrag": {
			"type": "stdio",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"src/backend/mcp_server/rag_mcp_stdio_server.py"
			],
			"cwd": "${workspaceFolder}"
		},
		"arxiv": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"tool",
				"run",
				"arxiv-mcp-server",
				"--storage-path",
				"${workspaceFolder}\\data\\arxiv_papers"
			],
			"cwd": "${workspaceFolder}"
		},
		"atlassian": {
			"type": "http",
			"url": "https://mcp.atlassian.com/v1/mcp"
		},
		"github": {
			"url": "https://api.githubcopilot.com/mcp/",
			"type": "http"
		}
	}
}
