{
  "servers": {
    "vontology": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pdm",
        "run",
        "python",
        "src/backend/mcp_server/mcp_stdio_server.py"
      ],
      "cwd": "${workspaceFolder}"
    },
    "vonrag": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pdm",
        "run",
        "python",
        "src/backend/mcp_server/rag_mcp_stdio_server.py"
      ],
      "cwd": "${workspaceFolder}"
    },
    "arxiv": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "tool",
        "run",
        "arxiv-mcp-server",
        "--storage-path",
        "${workspaceFolder}\\data\\arxiv_papers"
      ],
      "cwd": "${workspaceFolder}"
    },
    "mongodb": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server"
      ],
      "type": "stdio"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "type": "http"
    },
    "atlassian/atlassian-mcp-server": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/sse",
      "gallery": "https://api.mcp.github.com",
      "version": "1.0.0"
    }
  },
  "inputs": []
}
