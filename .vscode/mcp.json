{
  "servers": {
    "vontology": {
      "type": "stdio",
      "command": "pdm",
      "args": [
        "run",
        "python",
        "src/backend/mcp_server/mcp_stdio_server.py"
      ],
      "cwd": "${workspaceFolder}"
    },
    "vonrag": {
      "type": "stdio",
      "command": "pdm",
      "args": [
        "run",
        "python",
        "src/backend/mcp_server/rag_mcp_stdio_server.py"
      ],
      "cwd": "${workspaceFolder}"
    },
    "arxiv": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "tool",
        "run",
        "arxiv-mcp-server",
        "--storage-path",
        "${workspaceFolder}/data/arxiv_papers"
      ]
    }
  }
}
