{
  "name": "von",
  "version": "1.0.0",
  "description": "Von (or vonNeumarkt) is a suite of AI enriched tools for helping academic researchers",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:backend": "jest tests/backend",
    "test:frontend": "jest tests/frontend --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strong-AI-Lab/Von-Private.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Strong-AI-Lab/Von-Private/issues"
  },
  "homepage": "https://github.com/Strong-AI-Lab/Von-Private#readme",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.12",
    "@types/react-dom": "^18.2.5",
    "babel-jest": "^29.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pyright": "^1.1.405",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "contributes": {
    "models": [
      {
        "id": "von-private-vontology-provider",
        "path": "./src/backend/mcp_server/vontology_mcp.json",
        "requestHandler": {
          "url": "http://127.0.0.1:5002",
          "command": "von-mcp-server.start"
        }
      }
    ]
  }
}
