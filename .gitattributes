# Keep line endings explicit so Windows worktrees, Codex worktrees, and
# GitHub API publication paths do not silently disagree about text bytes.
* text=auto
.gitattributes text eol=lf

# Windows shell entry points.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Repo text formats that should remain LF across platforms and API uploads.
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary and generated assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip binary
*.gz binary

# Rebuilt from the pinned npm lockfile; preserve upstream string whitespace.
src/frontend/web/von_interface/static/vendor/conversation-visuals/** linguist-generated linguist-vendored -whitespace
