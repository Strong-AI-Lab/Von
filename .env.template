# Von Configuration Template
# Copy this file to .env and customize for your setup

# IMPORTANT:
# - Do NOT commit your repo-root `.env` file. It contains secrets and is ignored via `.gitignore`.
# - Only add non-secret defaults and commented placeholders to this `.env.template`.

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Option 1: Local MongoDB (Default)
# Install MongoDB Community Edition: https://www.mongodb.com/try/download/community
# After installation, MongoDB runs at localhost:27017 by default
MONGO_URI=mongodb://localhost:27017/

# Option 2: MongoDB Atlas (Cloud - Optional)
# Create free account: https://www.mongodb.com/cloud/atlas/register
# Replace with your connection string:
# MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/

# Optional: Atlas project name (used in error messages for IP whitelisting troubleshooting)
# MONGO_PROJECT=Your Project Name

# Database name (default: von_db)
VON_DB_NAME=von_db

# Local fallback URI (used if primary connection fails)
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_ALLOW_LOCAL_FALLBACK=1

# ============================================================================
# LLM PROVIDER API KEYS (Optional)
# ============================================================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here

# Google Gemini API Key
# Get yours at: https://ai.google.dev
# GOOGLE_API_KEY=your-key-here

# ============================================================================
# WEB SEARCH (Optional)
# ============================================================================

# Tavily API key (used by Von's internal Tavily MCP proxy).
# Note: Prefer keeping the key as `TAVILY_API_KEY` rather than embedding it in a URL.
# TAVILY_API_KEY=tvly-...

# ============================================================================
# OLLAMA CONFIGURATION (Local LLM - Recommended)
# ============================================================================

# Comma-separated list of Ollama server IPs
# Default: localhost only
OLLAMA_HOSTS_LIST=127.0.0.1

# To use remote Ollama servers, add their IPs:
# OLLAMA_HOSTS_LIST=127.0.0.1,192.168.1.100,192.168.1.101

# ============================================================================
# BACKUP TOOLING GUARDRAILS
# ============================================================================

# On-demand backups are admin-level operations and disabled by default.
# Set to 1 only when you intentionally need to run ".\run.ps1 backup".
# VON_ENABLE_BACKUP_ACTION=1

# Prefer a backup path outside the repository root to reduce accidental sharing.
# VON_BACKUP_ROOT=C:\von_backups
# If unset, run.ps1 resolves in this order:
# 1) W:\von_backups (when available)
# 2) %LOCALAPPDATA%\Von\backups
# 3) repo-local backups/ (last resort)

# Keep disabled by default. Setting this to 1 allows backup apply mode to write
# into repository paths (for exceptional local workflows only).
# VON_ALLOW_BACKUP_IN_REPO=0

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Use in-memory mock database for testing (no MongoDB required)
# VON_USE_MOCK_DB=1

# Enable MongoDB connection debug logging
# VON_DEBUG_MONGO=1

# Enable internal MCP features
# VON_INTERNAL_MCP_ENABLE=1

# ============================================================================
# ROOM DEVICE IDENTITY (Meeting-room voice)
# ============================================================================

# Fernet key used to issue/verify bearer tokens for room devices.
# Generate with:
#   pdm run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# VON_ROOM_DEVICE_TOKEN_KEY=your-fernet-key-here

# Protects admin provisioning endpoints (e.g., POST /admin/room_devices/provision).
# VON_ADMIN_TOKEN=your-admin-token-here

# Optional: PBKDF2 iteration count for hashing room device secrets.
# Default: 210000 (min enforced: 100000)
# VON_ROOM_DEVICE_SECRET_PBKDF2_ITERS=210000

# ============================================================================
# BLOB STORE / ARTEFACT STORAGE (Optional)
# ============================================================================

# Von can store durable artefacts (e.g., arXiv PDFs) via a pluggable blob store.
# Default backend is 'local' (writes to data/blob_store/).

# Select backend: 'local' (default) or 'swift'
# VON_BLOB_STORE_BACKEND=local

# Local backend root directory (optional; default: data/blob_store/)
# VON_BLOB_STORE_LOCAL_ROOT=C:\path\to\von_blob_store

# --- Swift backend (OpenStack Swift / Catalyst Cloud) ---
# VON_BLOB_STORE_BACKEND=swift

# Swift container name (required when backend=swift)
# VON_SWIFT_CONTAINER=von-artifacts

# Optional key prefix within the container
# VON_SWIFT_PREFIX=von

# Optional public base URL (if you have one) used to construct stable HTTP(S) URIs
# VON_SWIFT_PUBLIC_BASE_URL=https://object.your-cloud.example

# Authentication option A (recommended): clouds.yaml + OS_CLOUD
# See docs/engineering/catalyst_cloud_swift_setup.md
# OS_CLOUD=catalyst

# Authentication option B: explicit OpenStack environment variables (password auth)
# OS_AUTH_URL=https://api.nz-hlz-1.catalystcloud.io:5000/v3
# OS_USERNAME=your-username
# OS_PASSWORD=your-password
# OS_PROJECT_NAME=your-project-name
# OS_USER_DOMAIN_NAME=Default
# OS_PROJECT_DOMAIN_NAME=Default
# OS_REGION_NAME=nz-hlz-1

VON_RENDERER_APPLICABILITY_ROUTING_ENABLE=1
