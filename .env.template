# Von Configuration Template
# Copy this file to .env and customize for your setup

# IMPORTANT:
# - Do NOT commit your repo-root `.env` file. It contains secrets and is ignored via `.gitignore`.
# - Only add non-secret defaults and commented placeholders to this `.env.template`.

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Option 1: Local MongoDB (Default)
# Install MongoDB Community Edition: https://www.mongodb.com/try/download/community
# After installation, MongoDB runs at localhost:27017 by default
MONGO_URI=mongodb://localhost:27017/

# Option 2: MongoDB Atlas (Cloud - Optional)
# Create free account: https://www.mongodb.com/cloud/atlas/register
# Replace with your connection string:
# MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/

# Optional: Atlas project name (used in error messages for IP whitelisting troubleshooting)
# MONGO_PROJECT=Your Project Name

# Database name (default: von_db)
VON_DB_NAME=von_db

# Local fallback is disabled by default so a remote primary cannot silently
# downgrade to an old workstation database. Set this to 1 only as an explicit
# local-development choice.
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_ALLOW_LOCAL_FALLBACK=0
# MONGO_ALLOW_LOCAL_FALLBACK=1

# Optional remote recovery paths after the primary URI. For a pure DNS/SRV
# failure Von tries the lower-latency direct-host Atlas URI first. For TLS,
# TCP, health-check transport, or shared-retry operation failures it tries the
# supervised SSH forwards first. The explicit local-development fallback, if
# enabled, remains last.
#
# Supervised SSH forwards on loopback. Von derives the credential-bearing
# Mongo URIs in memory and selects only the writable replica member.
# MONGO_SSH_TUNNEL_FALLBACK_ENDPOINTS=127.0.0.1:27018,127.0.0.1:27019,127.0.0.1:27020
# MONGO_SSH_TUNNEL_EXPECTED_REPLICA_SET=atlas-example-shard-0
# A direct-host Atlas URI, useful when only SRV lookup is failing.
# MONGO_DNS_FALLBACK_URI=mongodb://YOUR_DIRECT_ATLAS_URI
# Optional: after system DNS fails for a host explicitly listed in the direct
# fallback URI, resolve only that host through these literal-IP resolvers.
# TLS still verifies the original Mongo hostname. No public resolver is used
# unless this setting is explicitly enabled.
# MONGO_DNS_RESOLVER_FALLBACK_NAMESERVERS=8.8.8.8,8.8.4.4
# MONGO_DNS_RESOLVER_FALLBACK_TIMEOUT_SECONDS=2
# MONGO_DNS_RESOLVER_FALLBACK_CACHE_SECONDS=60
# Optional: start on the configured direct-host route when the primary SRV
# resolver is known to be unavailable, avoiding the SRV lookup delay.
# MONGO_DNS_RESOLVER_FALLBACK_PREFER_DIRECT=0
#
# How long to keep a working fallback before probing the primary route again.
# VON_MONGO_FALLBACK_STICKY_SECONDS=300
#
# Optional hosted Mongo startup hardening:
# VON_MONGO_STRICT_STARTUP=1
# VON_MONGO_STARTUP_PROBE=1
# VON_MONGO_REQUIRE_TLS=1
# VON_MONGO_ALLOWED_HOST_SUFFIXES=.mongodb.net

# ============================================================================
# LLM PROVIDER API KEYS (Optional)
# ============================================================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here
# Optional same-provider backup. Von retries once with the same model only when
# the primary key receives an authentication, quota, or rate-limit rejection.
# The model footer then shows "backup key"; key values are never displayed.
# OPENAI_API_BACKUP_KEY=sk-proj-your-backup-key-here
# OPENAI_API_BACKUP_KEY_FILE=/etc/von/secrets/openai_api_backup_key

# Google Gemini API Key
# Get yours at: https://ai.google.dev
# Primary variable: GEMINI_API_KEY
# Managed hosts may set GEMINI_API_KEY_FILE to a root-owned secret file instead.
# Legacy alias still accepted for compatibility: GOOGLE_API_KEY
# GEMINI_API_KEY=<YOUR-GEMINI-KEY-HERE>
# GEMINI_API_KEY_FILE=/etc/von/secrets/gemini_api_key
# Optional same-provider backup with the same bounded retry behaviour:
# GEMINI_API_BACKUP_KEY=<YOUR-BACKUP-GEMINI-KEY-HERE>
# GEMINI_API_BACKUP_KEY_FILE=/etc/von/secrets/gemini_api_backup_key
# Legacy backup aliases: GOOGLE_API_BACKUP_KEY and GOOGLE_API_BACKUP_KEY_FILE
# VON_DEFAULT_GEMINI_MODEL=gemini-3.7-flash

# Meta Muse API Key
# Canonical direct value; managed hosts may use META_API_KEY_FILE instead.
# META_API_KEY=<YOUR-META-KEY-HERE>
# META_API_KEY_FILE=/etc/von/secrets/meta_api_key

# ============================================================================
# WEB SEARCH (Optional)
# ============================================================================

# Tavily API key (used by Von's internal Tavily MCP proxy).
# Note: Prefer keeping the key as `TAVILY_API_KEY` rather than embedding it in a URL.
# TAVILY_API_KEY=tvly-...

# ============================================================================
# OLLAMA CONFIGURATION (Local LLM - Recommended)
# ============================================================================

# Comma-separated list of Ollama server IPs
# Default: localhost only
OLLAMA_HOSTS_LIST=127.0.0.1

# To use remote Ollama servers, add their IPs:
# OLLAMA_HOSTS_LIST=127.0.0.1,192.168.1.100,192.168.1.101

# ============================================================================
# BACKUP TOOLING GUARDRAILS
# ============================================================================

# On-demand backups are admin-level operations and disabled by default.
# Set to 1 only when you intentionally need to run ".\run.ps1 backup".
# VON_ENABLE_BACKUP_ACTION=1

# Automatic daily backups are disabled by default on developer machines.
# Enable this only on the designated backup host for the configured database.
# VON_ENABLE_DAILY_BACKUP=1

# Compatibility opt-out for any host that must never run scheduled backups.
# VON_DISABLE_DAILY_BACKUP=1

# Prefer a backup path outside the repository root to reduce accidental sharing.
# VON_BACKUP_ROOT=C:\von_backups
# If unset, run.ps1 resolves in this order:
# 1) W:\von_backups (when available)
# 2) %LOCALAPPDATA%\Von\backups
# 3) repo-local backups/ (last resort)

# Keep disabled by default. Setting this to 1 allows backup apply mode to write
# into repository paths (for exceptional local workflows only).
# VON_ALLOW_BACKUP_IN_REPO=0

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Use in-memory mock database for testing (no MongoDB required)
# VON_USE_MOCK_DB=1

# Backend test safety:
# - Use test_von_db for pytest and other destructive test flows
# - run.ps1 intentionally blocks starting the real server with test_von_db
# VON_DB_NAME=test_von_db

# Enable MongoDB connection debug logging
# VON_DEBUG_MONGO=1

# Enable internal MCP features
# VON_INTERNAL_MCP_ENABLE=1

# ============================================================================
# HOSTED / CLOUD RUNTIME
# ============================================================================

# Prevent remote hosts or coding-agent sessions from trying to open a browser.
# VON_SKIP_BROWSER_LAUNCH=1

# Strong secret key for hosted sessions and OAuth. Required when
# GOOGLE_OAUTH_STRICT_STARTUP=1
# FLASK_SECRET_KEY=<YOUR-FLASK-SECRET-KEY-HERE>

# Prefer file-based secret injection on hosted systems when possible:
# MONGO_URI_FILE=/etc/von/secrets/mongo_uri
# GOOGLE_OAUTH_CLIENT_ID_FILE=/etc/von/secrets/google_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=/etc/von/secrets/google_oauth_client_secret

# If hosted browser testing needs Google login:
# GOOGLE_OAUTH_CLIENT_ID=<YOUR-CLIENT-ID-HERE>
# GOOGLE_OAUTH_CLIENT_SECRET=<YOUR-CLIENT-SECRET-HERE>
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/von/api/auth/google/callback
# GOOGLE_OAUTH_STRICT_STARTUP=1
#
# Dynamic redirects are for local/ngrok-style development only and are not
# compatible with strict hosted OAuth startup.
# GOOGLE_OAUTH_ENABLE_DYNAMIC_REDIRECTS=true

# ============================================================================
# ROOM DEVICE IDENTITY (Meeting-room voice)
# ============================================================================

# Fernet key used to issue/verify bearer tokens for room devices.
# Generate with:
#   pdm run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# VON_ROOM_DEVICE_TOKEN_KEY=your-fernet-key-here

# Protects admin provisioning endpoints (e.g., POST /admin/room_devices/provision).
# VON_ADMIN_TOKEN=your-admin-token-here

# Optional: PBKDF2 iteration count for hashing room device secrets.
# Default: 210000 (min enforced: 100000)
# VON_ROOM_DEVICE_SECRET_PBKDF2_ITERS=210000

# ============================================================================
# BLOB STORE / ARTEFACT STORAGE (Optional)
# ============================================================================

# Von can store durable artefacts (e.g., arXiv PDFs) via a pluggable blob store.
# Default backend is 'local' (writes to data/blob_store/).

# Select backend: 'local' (default) or 'swift'
# VON_BLOB_STORE_BACKEND=local

# Local backend root directory (optional; default: data/blob_store/)
# VON_BLOB_STORE_LOCAL_ROOT=C:\path\to\von_blob_store

# --- Swift backend (OpenStack Swift / Catalyst Cloud) ---
# VON_BLOB_STORE_BACKEND=swift

# Swift container name (required when backend=swift)
# VON_SWIFT_CONTAINER=von-artifacts

# Optional key prefix within the container
# VON_SWIFT_PREFIX=von

# Optional public base URL (if you have one) used to construct stable HTTP(S) URIs
# VON_SWIFT_PUBLIC_BASE_URL=https://object.your-cloud.example

# Authentication option A (recommended): clouds.yaml + OS_CLOUD
# See docs/engineering/catalyst_cloud_swift_setup.md
# OS_CLOUD=catalyst

# Authentication option B: explicit OpenStack environment variables (password auth)
# OS_AUTH_URL=https://api.nz-hlz-1.catalystcloud.io:5000/v3
# OS_USERNAME=your-username
# OS_PASSWORD=your-password
# OS_PROJECT_NAME=your-project-name
# OS_USER_DOMAIN_NAME=Default
# OS_PROJECT_DOMAIN_NAME=Default
# OS_REGION_NAME=nz-hlz-1

VON_RENDERER_APPLICABILITY_ROUTING_ENABLE=1
